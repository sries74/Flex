# Copy to .env (git-ignored) on the machine/VPS that needs it. NEVER commit real values.
# See docs/03-environment-setup.md §4/§6.

# --- VPS: /srv/flex/{prod,staging}/.env (chmod 600) ---
DB_PASSWORD=
DATABASE_URL=postgres://flex:${DB_PASSWORD}@db:5432/flex
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=            # server-side only; never ship in the app
SENTRY_DSN=
ROUTING_URL=http://routing:8080
API_PUBLIC_URL=https://api.flexcop.ackgent.com

# --- Local dev / CI (GitHub Actions secrets or EAS secrets, not this file) ---
EXPO_TOKEN=
SENTRY_AUTH_TOKEN=

# --- Community tooling (local only, read-only Reddit app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=flexcompanion-research/0.1 (by /u/<your-username>)
