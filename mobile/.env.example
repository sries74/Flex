# Copy to .env.local (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
EXPO_PUBLIC_API_URL=https://api.flexcop.ackgent.com

# Firebase Web app config (Firebase console → Project settings → Your apps). Public identifiers, safe to bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
